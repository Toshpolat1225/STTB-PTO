# AGMK-STTB — sozlamalar namunasi. Nusxa oling: cp .env.example .env  (.env repoga tushmaydi)
# Barcha maxfiy kalitlar shu faylda (IT talabi). .env repoga tushmaydi (.gitignore). Har server uchun yangi tasodifiy qiymat yozing:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
AGMK_DB_PASSWORD=ALMASHTIRING_baza_paroli
AGMK_JWT_SECRET=ALMASHTIRING_kamida_64_belgi
AGMK_ANON_KEY=agmk_ALMASHTIRING

# Telefonlar ulanadigan server manzil(lar)i — QR kodda chiqadi (vergul bilan): ichki tarmoq IP si va/yoki domen
AGMK_PUBLIC_HOSTS=192.168.1.10
# Telefonlar ulanadigan port (shlyuz)
AGMK_PUBLIC_PORT=8443
# Boshqaruv paneli porti (faqat shu kompyuterdan: http://127.0.0.1:<port>)
AGMK_ADMIN_HOST_PORT=8080

# Administrator tabel raqami (boshlangʻich parollar qoʻllanganda shu tabel administrator boʻladi)
AGMK_ADMIN=900777

# Korxona fayllari papkasi (serverda): xodimlar.json, paketlar/, imzo_yuklash/  — faqat oʻqish uchun ulanadi
AGMK_COMPANY_PATH=./company
# Zaxira nusxalar papkasi (serverda) va nechta oxirgi nusxa saqlansin
AGMK_BACKUP_PATH=./backups
AGMK_BACKUP_KEEP=30

# Bosib oʻtilgan yoʻl (trayektoriya) necha kun saqlansin
AGMK_TRK_DAYS=90
# OCR (Tesseract) obrazga qoʻshilsinmi: 1 — ha, 0 — yoʻq (obraz kichikroq)
AGMK_OCR=1
# Jurnal darajasi: info | warning | debug
AGMK_LOG_LEVEL=info
